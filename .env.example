# --- Gemini (Google AI Studio key). Used by the Research/Summary agents and guard Layers 2+4.
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash
GUARD_MODEL=gemini/gemini-2.5-flash

# --- Search provider: wikipedia (keyless) | brave | google
SEARCH_PROVIDER=wikipedia
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# --- Security Core location. Empty = in-process (local). Set to the Cloud Run guard URL in prod.
GUARD_URL=
GUARD_SHARED_SECRET=

# --- Hackathon cost protection (NOT part of the injection defense)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600
TRUSTED_PROXY_HOPS=1

# --- Per-session agent budgets
MAX_SEARCHES_PER_SESSION=3
MAX_PAGES_PER_SESSION=4
MAX_AGENT_STEPS=8
MAX_GEMINI_CALLS_PER_SESSION=14

# --- Finding/review persistence directory
LATCH_DATA_DIR=.latch_data
