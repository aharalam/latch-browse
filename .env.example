# --- OpenAI. Used by the Research/Summary agents and guard Layers 2+4.
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
GUARD_MODEL=openai/gpt-4o-mini

# --- Search provider: wikipedia (keyless) | brave | google
SEARCH_PROVIDER=wikipedia
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# --- Security Core location. Empty = in-process (local). Set to the Cloud Run guard URL in prod.
GUARD_URL=
GUARD_SHARED_SECRET=

# --- Hackathon cost protection (NOT part of the injection defense)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=3600
TRUSTED_PROXY_HOPS=1
# Empty by default: do not trust client-supplied X-Forwarded-For.
# Set only to the actual immediate proxy's CIDRs, with matching proxy hop count.
TRUSTED_PROXY_CIDRS=

# --- Per-session agent budgets
MAX_SEARCHES_PER_SESSION=3
MAX_PAGES_PER_SESSION=4
MAX_AGENT_STEPS=8
MAX_MODEL_CALLS_PER_SESSION=14
# Guard operations reserve four slots (L2/L4, two attempts each).
# The counter is a conservative upper bound, not a billing meter.

# --- Finding/review persistence directory
LATCH_DATA_DIR=.latch_data

# --- Shared state (Vercel only). The Vercel Marketplace Upstash Redis integration
# sets these automatically; UPSTASH_REDIS_REST_URL / _TOKEN are also accepted.
# Leave empty locally: sessions, findings and rate limits then stay in-process.
# Standard Redis / Redis Cloud integrations can use REDIS_URL instead.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
