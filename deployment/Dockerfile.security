FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY security_core/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY security_core/ ./security_core/
RUN useradd -r guard && chown -R guard /srv
USER guard
EXPOSE 8080
CMD ["sh", "-c", "uvicorn security_core.server:app --host 0.0.0.0 --port ${PORT:-8080} --timeout-keep-alive 30 --limit-concurrency 40"]
